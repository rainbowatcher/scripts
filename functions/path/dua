# 内联注释：确保遵循 Zsh 语法
emulate -L zsh

local target="${1:-.}"
target="${target:A}"

if (( $+commands[gdu] )); then
    gdu -ahd1 "$target" | sort -h
else
    local files=( "$target"/*(ND) )
    if (( ${#files} > 0 )); then
        du -sh "${files[@]}" | sort -h
    else
        echo "Directory is empty."
    fi
fi
